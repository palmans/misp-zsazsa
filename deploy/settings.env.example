# Site settings for this deployment. Copy to deploy/settings.env (git ignores
# it), fill in your values and run scripts/init.sh. init.sh writes everything
# else (the .env files, certificates, zsazsa and misp-scraper configuration)
# from these values, and generates the passwords and keys itself.

# Public hostname of MISP, as served by your reverse proxy (TLS terminates
# there). zsazsa is served on the same host, at https://<MISP_HOSTNAME>/zsazsa/
MISP_HOSTNAME=misp.example.com

# Administrator account and organisation created on the first start of MISP.
ADMIN_EMAIL=admin@example.com
ADMIN_ORG=Example Org

# Timezone of the containers.
TZ=UTC

# --- Network -----------------------------------------------------------------
# misp-nginx gets its own address on the LAN, so it needs no port on the
# Docker host. Your reverse proxy forwards to https://MISP_LAN_IP:MISP_HTTPS_PORT.
MISP_LAN_IP=192.168.1.19
# Ports misp-nginx listens on at MISP_LAN_IP (above 1024: nginx runs unprivileged).
# HTTP only redirects to BASE_URL.
MISP_HTTPS_PORT=8443
MISP_HTTP_PORT=8080

# The Docker network that puts misp-nginx on the LAN. "ipvlan" shares the MAC
# address of the parent interface and works in Proxmox LXC containers and
# behind MAC filtering; "macvlan" gives the container a MAC address of its own.
LAN_NETWORK_NAME=cti-lan
LAN_DRIVER=ipvlan
# Interface of the Docker host on the LAN (see "ip -br addr").
LAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# Addresses Docker may hand out on this network. Must contain MISP_LAN_IP and
# lie outside the DHCP pool of your router.
LAN_IP_RANGE=192.168.1.16/29

# --- Reverse proxy -----------------------------------------------------------
# Address of the reverse proxy in front of MISP. MISP trusts its
# X-Forwarded-For header, and the zsazsa containers reach MISP_HOSTNAME
# through it (no DNS record needed inside Docker).
PROXY_IP=192.168.1.105
# true when the reverse proxy has a certificate the containers trust (for
# example Let's Encrypt); false for a self-signed or private-CA certificate.
PROXY_CERT_VALID=true
