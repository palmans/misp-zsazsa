+    def _resolve_link(self, link) -> str:
+        """ The page behind a link that only redirects with JavaScript, which is not followed when scraping """
+        # NCSC-NL: /advisory?id=NCSC-2026-0525 -> /2026/ncsc-2026-0525.html
+        match = re.match(r"^https://advisories\.ncsc\.nl/advisory\?id=(NCSC-(\d{4})-\d+)$", link, re.IGNORECASE)
+        if match:
+            return "https://advisories.ncsc.nl/{}/{}.html".format(match.group(2), match.group(1).lower())
+        return link
+
